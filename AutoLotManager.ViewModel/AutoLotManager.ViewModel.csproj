<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Pages\Settings\" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project targets netstandard2.0 and must stay free of WPF/UI dependencies.
         The Syncfusion WPF packages were referenced here but never used by any type in
         this assembly, and had no netstandard2.0 assets, so NuGet fell back to .NET
         Framework ones and warned (NU1701) on every build. The Desktop project keeps
         its own Syncfusion references via packages.config. See issue #39. -->
    <PackageReference Include="Bogus" Version="34.0.2" />
    <PackageReference Include="Prism.Core" Version="7.2.0.1422" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoLotManager.Core\AutoLotManager.Core.csproj" />
  </ItemGroup>

</Project>
